{
  "name": "ykt-helper-userscript",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "rollup -c",
    "dev": "rollup -c -w",
    "test": "npm run test:legacy && npm run test:unit && npm run test:contract && npm run test:scenario",
    "test:legacy": "node --test test/*.test.js",
    "test:unit": "node --test test/unit/*.test.js",
    "test:contract": "node --test-concurrency=1 --import ./test/support/register-raw-loader.mjs --test test/contract/*.test.js",
    "test:scenario": "node --test-concurrency=1 --import ./test/support/register-raw-loader.mjs --test test/scenario/*.test.js",
    "test:build": "node --test test/build/*.test.js",
    "test:all": "npm test && npm run build && npm run test:build",
    "postbuild": "node -e \"import('./rollup.config.mjs').then(({ OUT_FILE }) => console.log('\\n✅ Build done: ' + OUT_FILE))\""
  },
  "devDependencies": {
    "@bkuri/rollup-plugin-string": "^1.0.0",
    "@rollup/plugin-replace": "^5.0.7",
    "@rollup/plugin-terser": "1.0.0",
    "rollup": "4.63.3"
  }
}
